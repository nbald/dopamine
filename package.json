{
  "name": "dopamine",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/build-dtach.mjs",
    "dev": "npx tsx watch src/server/index.ts & ./node_modules/.bin/vite; wait",
    "dev:server": "npx tsx watch src/server/index.ts",
    "dev:client": "./node_modules/.bin/vite",
    "build": "./node_modules/.bin/vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "reset-password": "npx tsx src/server/reset-password.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0",
    "node-pty": "^1.0.0",
    "better-sqlite3": "^11.7.0",
    "jsonwebtoken": "^9.0.2",
    "argon2": "^0.41.1",
    "selfsigned": "^2.4.1",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "cookie-parser": "^1.4.7",
    "multer": "^1.4.5-lts.1",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-webgl": "^0.18.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.13",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/multer": "^1.4.12",
    "vite": "^6.0.0",
    "svelte": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "concurrently": "^9.1.0"
  }
}
